{
  "name": "dsh-kunkun",
  "version": "0.5.0",
  "description": "Kunkun skin for DeepSeek Harness: a fixed corner mascot over the shell. / 坤坤皮肤：在界面右下角固定显示坤坤立绘的 DSH 外观插件。",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "assets/kunkun.webp",
    "assets/anim",
    "scripts"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "appearance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Junan-X/dsh-kunkun.git"
  },
  "homepage": "https://github.com/Junan-X/dsh-kunkun#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "make-anim": "node scripts/make-anim.mjs"
  }
}
